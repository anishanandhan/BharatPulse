rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Messages
    match /messages/{messageId} {
      function isValidMessage(data) {
        return data.keys().hasAll(['userId', 'userName', 'text', 'timestamp', 'type']) &&
               data.keys().size() == 5 &&
               data.userId is string && data.userId.size() <= 128 &&
               data.userName is string && data.userName.size() <= 50 &&
               data.text is string && data.text.size() <= 500 &&
               data.timestamp is timestamp &&
               data.type in ['fan', 'ai', 'system'];
      }

      allow read: if true; // ALLOW PUBLIC READS FOR HYPE
      
      allow create: if isSignedIn() && 
                    isValidMessage(request.resource.data) &&
                    (request.resource.data.userId == request.auth.uid || request.resource.data.type in ['ai', 'system']) &&
                    request.resource.data.timestamp == request.time;
    }
  }
}
